# ===== Trinh duyet (1 cua so Chrome dung chung cho WhatsApp, Sheets, Dashboard, Slides) =====
PROFILE_DIR=state/profile
BROWSER_CHANNEL=chrome

# ===== WhatsApp =====
WA_GROUP=ALL TEAM
# So dien thoai CUA BAN (chat voi chinh minh), dang 0912345678 hoac 84912345678
WA_SELF_PHONE=
# Nguoi nhan 2 anh BC1, BC2 (c Hang)
RECEIVER_PHONE=0904216183
# Cho toi da bao nhieu phut de cac bo phan bao du so
WAIT_MINUTES=30
POLL_SECONDS=4

# ===== Google Sheet (nhap % + copy bang) =====
SHEET_URL=https://docs.google.com/spreadsheets/d/15Sm08ghSTwDdjj85vZVLS43GQs6l7NBgAeFRJzZA_R0/edit?gid=0#gid=0
# O nhap % cua tung kenh (cot % Tien do, to mau xanh). KIEM TRA LAI SO DONG THAT TRONG SHEET.
SHEET_CELLS=Ads=J5;Livestream=J6;Website=J8;Zalo=J9;CSKH=J10;Bán Lẻ=J11
# Vung can copy: tu dong "Cap nhat ngay" den dong "TONG", 4 cot Kenh..KPI
SHEET_COPY_RANGE=H3:K12
# Sheet dung dau phay thap phan (kieu Viet Nam)
SHEET_DECIMAL=,

# ===== Dashboard =====
DASHBOARD_URL=https://duchuy64.github.io/sevenam-kpi-dashboard/#kpi

# ===== Google Slides =====
SLIDES_URL=https://docs.google.com/presentation/d/1D2NDk5Tn32VuoaRFjZ6vj_sQdXvibS4cW99IrXyNKrk/edit?slide=id.p#slide=id.p
# Vi tri hinh cu tren man hinh (ti le 0-1 theo chieu rong/cao cua so)
SLIDE_IMG_X=0.5
SLIDE_IMG_Y=0.5

# ===== Tuy chon: Claude doc tin nhan khi cach viet qua la =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
